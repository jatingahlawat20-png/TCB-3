# ==============================================================================
# TCB-3 PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or configure in your deployment platform (Vercel, Render, Railway, Docker, AWS)
# NEVER commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV="production"

# Canonical base URL of the deployed application (HTTPS required in production)
NEXT_PUBLIC_APP_URL="https://tcb3.fitness"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless Next.js queries (used at runtime)
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://[user]:[password]@[host]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct non-pooled connection string (used for migrations and schema deployments)
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://[user]:[password]@[host].[region].aws.neon.tech/[dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Strong cryptographic secret used to sign and verify session JWTs (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="YOUR_RANDOM_LONG_SECRET_KEY_MINIMUM_32_CHARS"

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API Key ID (Test key: rzp_test_..., Live key: rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Razorpay API Secret Key (Server-side only — NEVER expose to client)
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# Razorpay Webhook Secret for signature validation (Server-side only)
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Platform commission fee rate in percentage (defaults to 10%)
PLATFORM_FEE_PERCENT="10"

# ------------------------------------------------------------------------------
# 5. WEBRTC & LIVE COACHING (LiveKit Cloud)
# ------------------------------------------------------------------------------
# LiveKit Cloud WebSocket URL (e.g. wss://your-project.livekit.cloud)
LIVEKIT_URL="wss://YOUR_LIVEKIT_PROJECT.livekit.cloud"

# LiveKit API Key (Server-side only)
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"

# LiveKit API Secret (Server-side only — NEVER expose to client)
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# Session join window in minutes before scheduled time (defaults to 15)
SESSION_JOIN_WINDOW_MINUTES="15"
